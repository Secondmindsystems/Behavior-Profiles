{
  "schema_version": "0.1",
  "contract_id": "scope-control-runtime-contract-v0.1",
  "constitution": {
    "ref": "basis:812e5808d3aec291dceac9d3b35720e30eb42a60",
    "path": "products/behavior-profiles/scope-control/BEHAVIOR_PROFILE_SCOPE_CONTROL.md",
    "sha256": "769385360202ad58557d52ab1d3b9e1d3419a056b50f513af66d3604dab0e1d6"
  },
  "core_rule": "Do not silently expand the task.",
  "boundary_requirements": [
    "requested_task",
    "authorized_scope",
    "no_touch_boundaries",
    "authorized_actions",
    "done_condition",
    "stop_or_flag_condition"
  ],
  "runtime_invariants": {
    "no_touch_precedes_authorization": true,
    "commands_require_authority": true,
    "adjacent_work_is_not_current_authority": true,
    "ambiguity_requires_bounded_question": true,
    "malformed_input_fails_closed": true,
    "runtime_is_not_constitution": true
  },
  "decisions": ["ALLOW", "BLOCK", "ASK", "DEFER"],
  "decision_meanings": {
    "ALLOW": "the structurally declared action is authorized for the active task",
    "BLOCK": "the action is forbidden or cannot be lawfully evaluated",
    "ASK": "a frozen structural ambiguity predicate permits a bounded question",
    "DEFER": "the action is outside the active task and is preserved for later consideration"
  },
  "claim_boundary": {
    "semantic_judgment": false,
    "arbitrary_shell_governance": false,
    "universal_enforcement": false,
    "cross_client_compatibility": false
  }
}
